<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MAXINE</title>
  <link rel="stylesheet" href="style.css">
</head>

<body>

  <!-- PANTALLA 18+ -->
  <div id="age-screen">
    <div class="age-box">
      <h1>MAXINE</h1>
      <p>Solo para mayores de 18 años.</p>
      <button onclick="enterSite()">ENTRAR</button>
    </div>
  </div>

  <!-- ENCABEZADO -->
  <header>
    <div class="logo">MAXINE</div>

    <nav>
      <a href="#inicio">Inicio</a>
      <a href="#sobre">Sobre mí</a>
      <a href="#contenido">Contenido</a>
      <a href="#cuenta">Mi cuenta</a>
      <a href="#contacto">Contacto</a>
    </nav>
  </header>

  <main>

    <!-- INICIO -->
    <section id="inicio" class="hero">
      <div class="hero-content">
        <p class="small-title">WELCOME TO</p>
        <h1>MAXINE</h1>
        <p>Elegancia • Exclusividad • Fantasía</p>

        <a href="#contenido" class="btn">
          VER CONTENIDO
        </a>
      </div>
    </section>

    <!-- SOBRE MÍ -->
    <section id="sobre" class="section">
      <h2>Sobre mí</h2>

      <p>
        Bienvenido a mi espacio exclusivo.
        Aquí encontrarás contenido privado, fotografías,
        videos y acceso especial a Maxine.
      </p>
    </section>

    <!-- CUENTA -->
    <section id="cuenta" class="section">

      <p class="small-title">MEMBERS AREA</p>

      <h2>Mi cuenta</h2>

      <!-- REGISTRO -->
      <div id="register-box">

        <h3>Crear cuenta</h3>

        <form id="register-form">

          <input
            type="email"
            id="register-email"
            placeholder="Tu correo electrónico"
            required
          >

          <input
            type="password"
            id="register-password"
            placeholder="Contraseña"
            minlength="6"
            required
          >

          <button type="submit" class="btn">
            CREAR CUENTA
          </button>

        </form>

      </div>

      <!-- INICIO DE SESIÓN -->
      <div id="login-box">

        <h3>Iniciar sesión</h3>

        <form id="login-form">

          <input
            type="email"
            id="login-email"
            placeholder="Tu correo electrónico"
            required
          >

          <input
            type="password"
            id="login-password"
            placeholder="Contraseña"
            required
          >

          <button type="submit" class="btn">
            INICIAR SESIÓN
          </button>

        </form>

      </div>

      <!-- USUARIO CONECTADO -->
      <div id="user-box" style="display:none;">

        <h3>Cuenta activa</h3>

        <p id="user-email"></p>

        <button
          type="button"
          class="btn"
          onclick="logout()"
        >
          CERRAR SESIÓN
        </button>

      </div>

      <p id="auth-message"></p>

    </section>

    <!-- CONTENIDO -->
    <section id="contenido" class="section">

      <p class="small-title">EXCLUSIVE CONTENT</p>

      <h2>Contenido</h2>

      <div class="products">

        <!-- FOTOS -->
        <div class="product">

          <div class="product-icon">📸</div>

          <h3>FOTOS</h3>

          <p>
            Sets exclusivos de fotografías.
          </p>

          <div class="price">
            $29.80 USD
          </div>

          <button class="buy-btn">
            COMPRAR CON CRYPTO
          </button>

        </div>

        <!-- VIDEOS -->
        <div class="product">

          <div class="product-icon">🎥</div>

          <h3>VIDEOS</h3>

          <p>
            Videos individuales exclusivos.
          </p>

          <div class="price">
            $59.90 USD
          </div>

          <button class="buy-btn">
            COMPRAR CON CRYPTO
          </button>

        </div>

        <!-- MEMBRESÍA -->
        <div class="product featured">

          <div class="badge">
            BEST VALUE
          </div>

          <div class="product-icon">
            💎
          </div>

          <h3>2 YEARS</h3>

          <p>
            Membresía exclusiva durante 2 años.
          </p>

          <div class="price">
            $179.90 USD
          </div>

          <button class="buy-btn">
            GET MEMBERSHIP
          </button>

        </div>

      </div>

    </section>

    <!-- CONTACTO -->
    <section id="contacto" class="section">

      <h2>Contacto</h2>

      <p>
        Para información, compras y acceso exclusivo,
        utiliza los canales oficiales de Maxine.
      </p>

      <a href="#" class="btn">
        CONTACTAR
      </a>

    </section>

  </main>

  <footer>
    <p>
      © 2026 MAXINE • All Rights Reserved
    </p>
  </footer>

  <!-- SUPABASE -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <!-- JAVASCRIPT DE MAXINE -->
  <script src="script.js"></script>

</body>
</html>